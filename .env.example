# ==============================================================================
# VoiceForm Environment Configuration Example
# ==============================================================================
# NOTE: This file contains placeholders ONLY. NEVER commit actual API keys or secrets.
# Copy this file to backend/.env and fill in your actual credentials.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# ==============================================================================
# Rime Text-to-Speech (TTS) Configuration
# ==============================================================================
# Get your API key from: https://rime.ai/
RIME_API_KEY=your_rime_api_key_here
RIME_BASE_URL=https://users.rime.ai/v1/rime-tts
RIME_SPEAKER=marsh
RIME_MODEL_ID=mist
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLING_RATE=16000
TTS_TIMEOUT=15.0
TTS_SAFETY_MAX_CHARS=600

# ==============================================================================
# Local AI & Reasoning (Ollama / Qwen)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT=60.0
ASR_MODEL=Qwen/Qwen3-ASR-0.6B

# ==============================================================================
# Voice Activity Detection (Silero VAD ONNX)
# ==============================================================================
VAD_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=550
AUDIO_SAMPLE_RATE=16000

# ==============================================================================
# Database & Storage Configuration (Optional - Docker)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://voiceform:voiceform@127.0.0.1:5432/voiceform
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SECONDS=3600
ENABLE_PROFILE_PERSISTENCE=false
DEFAULT_PROFILE_ID=default_user
