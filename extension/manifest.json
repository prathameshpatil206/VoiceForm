{
  "manifest_version": 3,
  "name": "VoiceForm",
  "version": "0.1.0",
  "description": "VoiceForm - Voice-native interface for web forms (M1: DOM Form Scanner)",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoiceForm Form Inspector"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
